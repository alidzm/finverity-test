{
  "name": "program-capacity-service",
  "version": "0.1.0",
  "description": "Financing program capacity & invoice reservation service",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "lint": "oxlint --type-aware src/ test/ scripts/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "treasury": "tsx scripts/treasury.ts",
    "token": "./scripts/get-token.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@confluentinc/kafka-javascript",
      "@nestjs/core",
      "@swc/core",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf",
      "cpu-features",
      "protobufjs",
      "ssh2"
    ]
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "^1.11.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@testcontainers/kafka": "^12.2.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "chokidar": "^5.0.0",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
