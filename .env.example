# Running the service on the host (`pnpm start:dev`) against the docker-compose infrastructure.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true
SWAGGER_ENABLED=true
# Manual test console at /ui (local only).
DEV_UI_ENABLED=true

DATABASE_URL=postgres://capacity:capacity@localhost:5432/capacity
DATABASE_POOL_MAX=20

AUTH_ISSUER=http://localhost:8080/realms/capacity
AUTH_AUDIENCE=capacity-service
AUTH_JWKS_URI=http://localhost:8080/realms/capacity/protocol/openid-connect/certs

KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=capacity-service
# KAFKA_SSL=true
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

CONSUMERS_ENABLED=true
OUTBOX_RELAY_ENABLED=true

# Reject reservations when the latest FX rate is older than this.
FX_MAX_RATE_AGE_SECONDS=86400
# Local reservations younger than (snapshot asOf - grace) are treated as in flight.
RECONCILIATION_GRACE_SECONDS=300
SSE_HEARTBEAT_INTERVAL_MS=15000
